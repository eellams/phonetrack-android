<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+, targetSdk 37+: needed to reach a server on the LAN (see LocalNetworkAccess) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- For auto start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- For web sync retries -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- LoggerService records location for as long as tracking is enabled -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- SmsAlarmService rings the alarm requested by the "alarm" SMS command -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- For SSO account import -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <!-- For SMS logjob activation -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Needed if app targets API >= 21 -->
    <uses-feature android:name="android.hardware.location.gps" />
    <uses-feature android:name="android.hardware.location.network" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- To let the user disable battery optimization from the app -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name="net.eneiluj.nextcloud.phonetrack.util.PhoneTrack"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="standard"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
            <meta-data
                android:name="android.app.default_searchable"
                android:value="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity" />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.SettingsActivity"
            android:label="@string/settings_server_settings"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.PreferencesActivity"
            android:windowSoftInputMode="stateVisible"
            android:launchMode="standard"
            />

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.SyslogManagerActivity"
            android:label="@string/settings_syslog_label"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.PreferencesActivity"
            android:windowSoftInputMode="stateVisible"
            android:launchMode="standard"
            />

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.PreferencesActivity"
            android:label="@string/action_settings"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:windowSoftInputMode="stateHidden"
            android:theme="@style/Preferences"
            android:launchMode="standard"
            />

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.EditPhoneTrackLogjobActivity"
            android:label="@string/simple_edit_pt"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:windowSoftInputMode="stateHidden"
            android:launchMode="standard"
            android:exported="true">
            <!-- this is to receive share action from other apps -->
            <intent-filter android:label="@string/action_create_share">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.EditCustomLogjobActivity"
            android:label="@string/simple_edit_cu"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:windowSoftInputMode="stateHidden"
            android:launchMode="standard"
            android:exported="true">
            <!-- this is to receive share action from other apps -->
            <intent-filter android:label="@string/action_create_custom_share">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.EditMapsLogjobActivity"
            android:label="@string/simple_edit_cu"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:windowSoftInputMode="stateHidden"
            android:launchMode="standard">
        </activity>

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.AboutActivity"
            android:label="@string/simple_about"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:launchMode="standard"
            />

        <activity
            android:name="net.eneiluj.nextcloud.phonetrack.android.activity.MapActivity"
            android:label="@string/simple_map"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName="net.eneiluj.nextcloud.phonetrack.android.activity.LogjobsListViewActivity"
            android:launchMode="standard"
            />

        <service
            android:name="net.eneiluj.nextcloud.phonetrack.android.quicksettings.NewLogjobTileService"
            android:icon="@drawable/ic_quicksettings_new"
            android:label="@string/action_create"
            android:description="@string/action_create"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="net.eneiluj.nextcloud.phonetrack.service.LoggerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- short-lived: rings the alarm requested by the "alarm" SMS command -->
        <service
            android:name="net.eneiluj.nextcloud.phonetrack.service.SmsAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- short-lived: gets a GPS fix to answer an SMS position request -->
        <service
            android:name="net.eneiluj.nextcloud.phonetrack.service.SmsLocationSendService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- BOOT_COMPLETED is sent by the system, which may deliver to
             non-exported receivers; nothing else should be able to trigger it.
             (QUICKBOOT_POWERON was dropped: onReceive only acts on BOOT_COMPLETED.) -->
        <receiver
            android:name="net.eneiluj.nextcloud.phonetrack.service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Must stay exported to receive SMS_RECEIVED, so require the permission
             only the telephony stack holds. Without it any installed app could send
             a forged SMS and trigger the remote commands (start tracking, send position). -->
        <receiver
            android:name="net.eneiluj.nextcloud.phonetrack.service.SmsListener"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- cert4android's certificate dialog. The library exports it and applies a trust
             decision passed as an intent extra, so any installed app could make PhoneTrack
             trust its own certificate (and read the traffic to the server). Only PhoneTrack
             opens it: directly, or through its own notification's PendingIntent. -->
        <activity
            android:name="at.bitfire.cert4android.TrustCertificateActivity"
            android:exported="false"
            tools:replace="android:exported" />

    </application>
</manifest>
